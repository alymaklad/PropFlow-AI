# Copy to .env and fill in. Never commit .env.
# Values below are DEV-ONLY placeholders; generate your own secrets.

# --- PropFlow Postgres (application schema) ---
PROPFLOW_DB_NAME=propflow
PROPFLOW_DB_USER=propflow
PROPFLOW_DB_PASSWORD=change-me-propflow-db
PROPFLOW_DB_PORT=5433

# --- Odoo ---
ODOO_VERSION=17.0
ODOO_PORT=8069
ODOO_DB_NAME=propflow_odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-odoo-db
# Integration user + API key: see odoo/README.md. The key is used in place of the
# password in JSON-RPC execute_kw calls. Leave empty until created.
ODOO_URL=http://odoo:8069
ODOO_INTEGRATION_LOGIN=propflow-integration
ODOO_INTEGRATION_EMAIL=propflow-noreply@example.com
ODOO_API_KEY=
# Sales team whose members receive leads round-robin (empty = the first team, "Sales")
ODOO_SALES_TEAM_ID=

# --- n8n ---
N8N_VERSION=2.42.2
N8N_PORT=5678
# n8n execution history (contains lead data) is pruned after this many hours
N8N_EXECUTIONS_MAX_AGE_HOURS=168
# 32+ random chars: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Shared secret for HMAC verification of inbound webhooks
WEBHOOK_HMAC_SECRET=change-me-webhook-secret

# --- AI qualification service ---
AI_SERVICE_PORT=8000
# Shared with n8n, sent as X-API-Key
AI_SERVICE_API_KEY=change-me-service-key
# groq | none (none = AI off: free-text leads are handed to a salesperson)
LLM_PROVIDER=none
GROQ_API_KEY=
# Both support Groq's strict JSON-schema mode; 20b is the faster fallback.
GROQ_MODEL=openai/gpt-oss-120b
# Strict JSON-schema mode (constrained decoding). Set false to use best-effort mode.
GROQ_STRICT=true
# Optional for reasoning models: low | medium | high (empty = provider default)
GROQ_REASONING_EFFORT=
# Rate-limit resilience: attempts per call and the longest Retry-After wait honoured (s)
GROQ_MAX_ATTEMPTS=5
GROQ_MAX_RETRY_WAIT=20
# Below this model confidence, a lead is handed to a salesperson
QUALIFY_MIN_CONFIDENCE=0.6

# Buyer site and staff dashboard
WEB_PORT=3000
# Staff dashboard sign-in token (openssl rand -hex 24)
STAFF_TOKEN=change-me-staff-token

# --- Mail (Mailpit in dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
NOTIFY_FROM_EMAIL=propflow-noreply@example.com
# Operational alerts (failed workflows, leads without an owner). Mailpit catches it in dev.
ALERT_EMAIL=ops@example.com
# Inbound mailbox for email inquiries and customer replies (GreenMail in dev)
INBOUND_EMAIL=leads@propflow.test
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
# Daily/weekly operational report recipient
REPORT_EMAIL=ops@example.com
# At most this many customer emails per address per 24 hours
MAX_CUSTOMER_EMAILS_PER_DAY=3
# Base URL used in links to Odoo records
ODOO_PUBLIC_URL=http://localhost:8069
