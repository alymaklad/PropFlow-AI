        2860,
        600
      ],
      "parameters": {
        "jsCode": "// One item per email to send. Entries that could not reach their intended recipient (no\n// owner, no manager) become ops alerts. Everything else (opted out, already sent) is skipped.\nconst messages = $('Next action').first().json.messages;\nconst items = [];\nfor (const m of messages) {\n  if (m.send) {\n    items.push({ json: { to: m.to, subject: m.subject, text: m.text, message_id: m.message_id, kind: m.kind } });\n  } else if (['no_owner', 'no_manager'].includes(m.reason)) {\n    const who = m.reason === 'no_owner' ? 'a salesperson' : 'a sales manager';\n    items.push({ json: {\n      to: $env.ALERT_EMAIL, message_id: null, kind: 'ops',\n      subject: `[PropFlow] Lead #${m.lead_id} needs attention`,\n      text: `PropFlow could not reach ${who} for lead #${m.lead_id}. Assign it in Odoo:\\n${m.lead_url}`,\n    } });\n  }\n}\nreturn items.length ? items : [{ json: { none: true } }];"
      }
