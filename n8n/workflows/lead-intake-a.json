        220,
        300
      ],
      "parameters": {
        "jsCode": "// Forward the exact raw body and signature headers; the service verifies the signature.\nconst item = $input.first();\nconst headers = item.json.headers || {};\nlet rawBody = '';\ntry {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (e) {\n  rawBody = '';\n}\nreturn [{ json: {\n  source: 'form',\n  raw_body: rawBody,\n  timestamp: headers['x-propflow-timestamp'] || null,\n  signature: headers['x-propflow-signature'] || null,\n  idempotency_key: headers['x-idempotency-key'] || null,\n} }];"
      }
    },
    {
      "id": "5f0f0000-0000-4000-8000-000000000003",
      "name": "Receive & claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
