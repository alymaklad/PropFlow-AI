    {
      "id": "5f0f0000-0000-4000-8000-000000000014",
      "name": "Compose rep email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        340
      ],
      "parameters": {
        "jsCode": "// Internal notification: requirements, score reasons and a link. No customer contact\n// details in the email; the rep opens the lead in Odoo for those.\nconst lead = $('Normalize').first().json;\nconst score = $('Score').first().json;\nconst up = $('Upsert lead in Odoo').first().json;\nconst reqs = [\n  ['Property type', lead.property_type], ['Location', lead.location || lead.location_raw],\n  ['Bedrooms', lead.bedrooms], ['Budget from', lead.budget_min], ['Budget up to', lead.budget_max],\n  ['Currency', lead.currency], ['Timeline (months)', lead.purchase_timeline_months],\n].filter(([, v]) => v !== null && v !== undefined).map(([k, v]) => `  ${k}: ${v}`);\nconst reasons = score.components.map(c => `  ${c.rule}: +${c.points} (${c.reason})`);\nconst text = [\n  `Hi ${up.owner.name},`, '',\n  `A high-priority lead (score ${score.total}) has been assigned to you.`, '',\n  'Requirements:', ...(reqs.length ? reqs : ['  (none provided)']), '',\n  'Why it scored high:', ...reasons, '',\n  `Open the lead: ${up.lead_url}`, '',\n  'A follow-up activity is waiting for you in Odoo.', '-- PropFlow',\n].join('\\n');\nreturn [{ json: {\n  to: up.owner.email,\n  subject: `[PropFlow] High-priority lead #${up.lead_id} (score ${score.total})`,\n  text,\n} }];"
      }
    },
