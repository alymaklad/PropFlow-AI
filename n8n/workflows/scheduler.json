{
  "id": "PropFlowSchedul1",
  "name": "PropFlow - Scheduler (handoffs, follow-ups)",
  "active": true,
  "nodes": [
    {
      "id": "5f100000-0000-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "5f100000-0000-4000-8000-000000000002",
      "name": "Check handoffs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SERVICE_URL }}/v1/handoffs/check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5f100000-0000-4000-8000-000000000003",
      "name": "Due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SERVICE_URL }}/v1/followups/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5f100000-0000-4000-8000-00000000001e",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1760,
        300
      ],
      "parameters": {},
      "executeOnce": true
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000a",
      "name": "Split messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// One item per email to send. Entries that could not reach their intended recipient (no\n// owner, no manager) become ops alerts. Everything else (opted out, already sent) is skipped.\nconst messages = [...$('Check handoffs').first().json.messages, ...$('Due follow-ups').first().json.messages];\nconst items = [];\nfor (const m of messages) {\n  if (m.send) {\n    items.push({ json: { to: m.to, subject: m.subject, text: m.text, message_id: m.message_id, kind: m.kind } });\n  } else if (['no_owner', 'no_manager'].includes(m.reason)) {\n    const who = m.reason === 'no_owner' ? 'a salesperson' : 'a sales manager';\n    items.push({ json: {\n      to: $env.ALERT_EMAIL, message_id: null, kind: 'ops',\n      subject: `[PropFlow] Lead #${m.lead_id} needs attention`,\n      text: `PropFlow could not reach ${who} for lead #${m.lead_id}. Assign it in Odoo:\\n${m.lead_url}`,\n    } });\n  }\n}\nreturn items.length ? items : [{ json: { none: true } }];"
      }
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000b",
      "name": "Anything to send?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.none ? 0 : 1 }}"
      }
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000c",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        400
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "fromEmail": "=\"PropFlow Real Estate\" <{{ $env.NOTIFY_FROM_EMAIL }}>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $env.REPLY_TO_EMAIL }}"
        }
      },
      "credentials": {
        "smtp": {
          "id": "MailpitSmtpDev01",
          "name": "Mailpit SMTP (dev)"
        }
      }
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000d",
      "name": "Ledgered (sent)?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $('Split messages').item.json.message_id ? 1 : 0 }}"
      }
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000e",
      "name": "Ledgered (failed)?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1320,
        520
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $('Split messages').item.json.message_id ? 1 : 0 }}"
      }
    },
    {
      "id": "5f100000-0000-4000-8000-00000000000f",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SERVICE_URL }}/v1/outbound/{{ $('Split messages').item.json.message_id }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', provider_msg_id: $json.messageId || null }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5f100000-0000-4000-8000-000000000010",
      "name": "Mark failed send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1540,
        560
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SERVICE_URL }}/v1/outbound/{{ $('Split messages').item.json.message_id }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AI_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', error: String($json.error?.message || 'send failed').slice(0, 1900) }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Check handoffs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check handoffs": {
      "main": [
        [
          {
            "node": "Due follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Due follow-ups": {
      "main": [
        [
          {
            "node": "Split messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split messages": {
      "main": [
        [
          {
            "node": "Anything to send?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything to send?": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Ledgered (sent)?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ledgered (failed)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ledgered (sent)?": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ledgered (failed)?": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark sent": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark failed send": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "PropFlowErrorWf1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  }
}
