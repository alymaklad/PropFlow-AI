# PropFlow AI: public demo on a server (synthetic data only). Create the real file with
#   deploy/make-env.sh
# which fills every secret with a fresh random value. Never reuse development secrets.

# Include the production override in every docker compose / make command
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Public address and reviewer access ---
PUBLIC_HOST=propflow-demo.duckdns.org      # your DuckDNS name
MAIL_VIEWER_USER=reviewer                  # login for https://PUBLIC_HOST/mail/
MAIL_VIEWER_PASSWORD_HASH=                 # bcrypt hash (make-env.sh creates it); keep the single quotes
PUBLIC_DAILY_LIMIT=100                     # public inquiries per 24 h across all visitors
STAFF_TOKEN=                               # staff dashboard sign-in; share with reviewers
HEALTHCHECK_URL=                           # optional Healthchecks.io ping URL for backups
MAILPIT_WEBROOT=/mail                      # lets the scenario runner find Mailpit behind /mail

# --- PropFlow Postgres ---
PROPFLOW_DB_NAME=propflow
PROPFLOW_DB_USER=propflow
PROPFLOW_DB_PASSWORD=

# --- Odoo (private: reach it over an SSH tunnel) ---
ODOO_VERSION=17.0
ODOO_DB_NAME=propflow_odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=
ODOO_URL=http://odoo:8069
ODOO_PUBLIC_URL=http://localhost:8069      # links work through the SSH tunnel
ODOO_INTEGRATION_LOGIN=propflow-integration
ODOO_INTEGRATION_EMAIL=propflow-noreply@example.com
ODOO_API_KEY=                              # written by make odoo-bootstrap on first deploy
ODOO_SALES_TEAM_ID=                        # written by make odoo-seed on first deploy

# --- n8n (private) ---
N8N_VERSION=2.42.2
N8N_ENCRYPTION_KEY=
WEBHOOK_HMAC_SECRET=
N8N_EXECUTIONS_MAX_AGE_HOURS=72

# --- AI qualification service ---
AI_SERVICE_API_KEY=
LLM_PROVIDER=groq
GROQ_API_KEY=                              # a separate key for the demo
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRICT=true
GROQ_MAX_ATTEMPTS=5
GROQ_MAX_RETRY_WAIT=20
QUALIFY_MIN_CONFIDENCE=0.6
MAX_CUSTOMER_EMAILS_PER_DAY=3

# --- Mail: captured by Mailpit, never delivered (demo) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
NOTIFY_FROM_EMAIL=propflow-noreply@example.com
INBOUND_EMAIL=leads@propflow.test
ALERT_EMAIL=ops@example.com
REPORT_EMAIL=ops@example.com

# --- Business calendar ---
BUSINESS_TZ=Africa/Cairo
BUSINESS_HOURS=09:00-17:00
BUSINESS_DAYS=6,0,1,2,3

# For a real deployment (not this demo): your own domain, a real SMTP provider with SPF/DKIM,
# a real inbox, SSO for staff, and the checks in docs/deployment-plan.md section 6.
