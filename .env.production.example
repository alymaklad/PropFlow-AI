# PropFlow AI: public demo on a server (synthetic data only). Create the real file with
#   deploy/make-env.sh
# which fills every secret with a fresh random value. Never reuse development secrets.

# Include the production override in every docker compose / make command
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Public address and reviewer access ---
# your DuckDNS name
PUBLIC_HOST=propflow-demo.duckdns.org
# login for https://PUBLIC_HOST/mail/
MAIL_VIEWER_USER=reviewer
# bcrypt hash (make-env.sh creates it); keep the single quotes
MAIL_VIEWER_PASSWORD_HASH=
# public inquiries per 24 h across all visitors
PUBLIC_DAILY_LIMIT=100
# staff dashboard sign-in; share with reviewers
STAFF_TOKEN=
# optional Healthchecks.io ping URL for backups
HEALTHCHECK_URL=
# lets the scenario runner find Mailpit behind /mail
MAILPIT_WEBROOT=/mail

# --- PropFlow Postgres ---
PROPFLOW_DB_NAME=propflow
PROPFLOW_DB_USER=propflow
PROPFLOW_DB_PASSWORD=

# --- Odoo (private: reach it over an SSH tunnel) ---
ODOO_VERSION=17.0
ODOO_DB_NAME=propflow_odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=
ODOO_URL=http://odoo:8069
# links work through the SSH tunnel
ODOO_PUBLIC_URL=http://localhost:8069
ODOO_INTEGRATION_LOGIN=propflow-integration
ODOO_INTEGRATION_EMAIL=propflow-noreply@example.com
# written by make odoo-bootstrap on first deploy
ODOO_API_KEY=
# written by make odoo-seed on first deploy
ODOO_SALES_TEAM_ID=

# --- n8n (private) ---
N8N_VERSION=2.42.2
N8N_ENCRYPTION_KEY=
WEBHOOK_HMAC_SECRET=
N8N_EXECUTIONS_MAX_AGE_HOURS=72

# --- AI qualification service ---
AI_SERVICE_API_KEY=
LLM_PROVIDER=groq
# a separate key for the demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRICT=true
GROQ_MAX_ATTEMPTS=5
GROQ_MAX_RETRY_WAIT=20
QUALIFY_MIN_CONFIDENCE=0.6
MAX_CUSTOMER_EMAILS_PER_DAY=3

# --- Mail: captured by Mailpit; real delivery is optional (deploy/enable-email.sh) ---
# true = customer emails also reach the visitor through the SMTP account below
MAIL_RELAY_ENABLED=false
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
NOTIFY_FROM_EMAIL=propflow-noreply@example.com
INBOUND_EMAIL=leads@propflow.test
ALERT_EMAIL=ops@example.com
REPORT_EMAIL=ops@example.com

# --- Business calendar ---
BUSINESS_TZ=Africa/Cairo
BUSINESS_HOURS=09:00-17:00
BUSINESS_DAYS=6,0,1,2,3

# For a real deployment (not this demo): your own domain, a real SMTP provider with SPF/DKIM,
# a real inbox, SSO for staff, and the checks in docs/deployment-plan.md section 6.
