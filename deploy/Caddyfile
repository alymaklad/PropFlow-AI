# Public entry point for the demo. HTTPS certificates are obtained automatically.
{$PUBLIC_HOST} {
	encode zstd gzip

	# Captured emails for reviewers (Mailpit), password protected.
	handle /mail* {
		basic_auth {
			{$MAIL_VIEWER_USER} {$MAIL_VIEWER_PASSWORD_HASH}
		}
		reverse_proxy mailpit:8025
	}

	# Buyer site and staff dashboard (nginx proxies only /api/public and /api/staff).
	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Odoo CRM for reviewers (read-only "reviewer" login; see scripts/odoo-accounts.sh).
# The database manager and the external XML-RPC/JSON-RPC APIs stay internal: the PropFlow
# service talks to Odoo directly on the private network.
odoo.{$PUBLIC_HOST} {
	encode zstd gzip

	@internal path /web/database* /xmlrpc* /jsonrpc*
	respond @internal 404

	reverse_proxy odoo:8069

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
